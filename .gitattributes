# Normalizar finales de linea en el repositorio y dejar los nativos en el arbol
# de trabajo. Sin esto, cada `git add` desde Windows suelta cuarenta avisos.
* text=auto

# Los scripts de PowerShell con CRLF, que es lo nativo de Windows.
*.ps1 text eol=crlf

# Binarios: que git no los toque.
*.png binary
*.ico binary
