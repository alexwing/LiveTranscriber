# Rust
/target
**/target

# Node
node_modules
dist

# Generado por Tauri
/src-tauri/gen

# Python. Sin barra final a proposito: con `.venv/` el patron solo casa con un
# directorio que ya exista, y aqui el venv son ~4,7 GB que no deben colarse.
# `.venv-tts` es el entorno de la voz (install.ps1 -WithVoice), otros ~7 GB.
.venv
.venv-tts
venv
__pycache__/
*.pyc

# Configuracion local. Lleva rutas absolutas de la maquina, y a menudo nombres
# de carpetas y de ficheros que no tienen por que salir de aqui. La plantilla
# esta en transcriber-config.example.toml.
transcriber-config.toml

# Transcripciones exportadas: son contenido de quien use la app, no del repo.
# La excepcion cubre requirements.txt Y requirements-tts.txt: con solo el
# primero, la receta del venv de voz quedaba invisible para git y un
# `git add -A` la dejaba fuera sin ningun aviso.
*.srt
*.txt
!requirements*.txt

*.log
.DS_Store
